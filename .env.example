# Pulse — шаблон переменных окружения. Значения не коммитим (docs/SETUP.md §2, §4).
# Скопируйте в .env.local и заполните. Preview → значения dev-инстанса, Production → prod.

# --- Supabase ---
# URL проекта Supabase (публичная)
NEXT_PUBLIC_SUPABASE_URL=
# Anon-ключ Supabase (публичная)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role ключ — ТОЛЬКО сервер, никогда не в клиентский бандл
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (локальная работа, в Vercel не нужны) ---
# Personal access token CLI: supabase login или это значение
SUPABASE_ACCESS_TOKEN=
# Пароль БД слинкованного dev-проекта — нужен для db push / db reset --linked
SUPABASE_DB_PASSWORD=
# Пароли демо-учёток dev для смоуков (scripts/lib/demo-password.ts); в репозитории их нет.
# Для локальной базы из сида — пароли сида
SMOKE_DIRECTOR_PASSWORD=
SMOKE_PASSWORD=

# --- AI ---
# Ключ OpenAI — STT (gpt-4o-transcribe)
OPENAI_API_KEY=
# Ключ Anthropic — парсер на Claude
ANTHROPIC_API_KEY=
# Ключ Deepgram — запасной STT-провайдер
DEEPGRAM_API_KEY=
# Ключ ElevenLabs — запасной STT-провайдер
ELEVENLABS_API_KEY=
# Ключ DeepSeek — экспериментальный провайдер парсера (deepseek-chat / deepseek-reasoner) для сравнения с Haiku в лаборатории
DEEPSEEK_API_KEY=
# Модель парсера голосовых команд
PARSER_MODEL=claude-haiku-4-5
# Модель эскалации парсера при низкой уверенности
PARSER_ESCALATION_MODEL=claude-sonnet-5

# --- Web Push (VAPID) ---
# Публичный VAPID-ключ; своя пара на каждую среду, смена убивает подписки
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Приватный VAPID-ключ — только сервер
VAPID_PRIVATE_KEY=
# Контакт владельца подписок, формат mailto:...
VAPID_SUBJECT=

# --- Cron и коды входа ---
# Секрет для защиты cron-эндпоинтов от посторонних вызовов
CRON_SECRET=
# Ключ HMAC кодов входа (D-135), только сервер. Пусто — выводится из SUPABASE_SERVICE_ROLE_KEY; смена гасит лишь выданные коды (живут 15 минут)
LOGIN_CODE_SECRET=

# --- Консоль разработчиков (D-157) ---
# Свой хост консоли: задан — /ops и /api/ops отвечают только на нём. Пусто — на любом хосте деплоя
OPS_HOST=
# Адрес приложения для ссылок входа из консоли (https://...). Нужен вместе с OPS_HOST: хост консоли приложение не отдаёт
OPS_APP_ORIGIN=
