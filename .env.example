# Pulse — шаблон переменных окружения. Значения не коммитим (docs/SETUP.md §2, §4).
# Скопируйте в .env.local и заполните. Preview → значения dev-инстанса, Production → prod.

# --- Supabase ---
# URL проекта Supabase (публичная)
NEXT_PUBLIC_SUPABASE_URL=
# Anon-ключ Supabase (публичная)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role ключ — ТОЛЬКО сервер, никогда не в клиентский бандл
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (локальная работа, в Vercel не нужны) ---
# Personal access token CLI: supabase login или это значение
SUPABASE_ACCESS_TOKEN=
# Пароль БД слинкованного dev-проекта — нужен для db push / db reset --linked
SUPABASE_DB_PASSWORD=

# --- AI ---
# Ключ OpenAI — STT (gpt-4o-transcribe)
OPENAI_API_KEY=
# Ключ Anthropic — парсер и вопросы к данным
ANTHROPIC_API_KEY=
# Активный STT-провайдер за интерфейсом transcribe()
STT_PROVIDER=openai
# Запасной STT-провайдер на случай сбоя основного
STT_FALLBACK_PROVIDER=
# Ключ Deepgram — запасной STT-провайдер
DEEPGRAM_API_KEY=
# Ключ ElevenLabs — запасной STT-провайдер
ELEVENLABS_API_KEY=
# Модель парсера голосовых команд
PARSER_MODEL=claude-haiku-4-5
# Модель эскалации парсера при низкой уверенности
PARSER_ESCALATION_MODEL=claude-sonnet-5
# Модель ассистента для вопросов к данным
QUERY_MODEL=claude-sonnet-5

# --- Demo instance (dev / demo only; a client's prod never sets these) ---
# Server lock of «Обнулить демо-базу»: 1 lets the director wipe the company's activity
DEMO_RESET_ENABLED=
# Shows the reset button in Settings (client bundle); the server lock still decides
NEXT_PUBLIC_DEMO_MODE=

# --- Web Push (VAPID) ---
# Публичный VAPID-ключ; своя пара на каждую среду, смена убивает подписки
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Приватный VAPID-ключ — только сервер
VAPID_PRIVATE_KEY=
# Контакт владельца подписок, формат mailto:...
VAPID_SUBJECT=

# --- Telegram ---
# Токен бота — свой бот на каждую среду
TELEGRAM_BOT_TOKEN=
# Secret_token вебхука, сверяется функцией tg-webhook
TELEGRAM_WEBHOOK_SECRET=

# --- Внутренние вызовы и cron ---
# Заголовок x-internal-secret для вызовов pg_net → Edge Functions
INTERNAL_FN_SECRET=
# Секрет для защиты cron-эндпоинтов от посторонних вызовов
CRON_SECRET=

# --- Наблюдаемость ---
# DSN Sentry для серверной части
SENTRY_DSN=
# DSN Sentry для клиентской части (публичная)
NEXT_PUBLIC_SENTRY_DSN=
