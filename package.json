{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:parser": "tsx tests/ai/eval.ts",
    "test:stt": "node tests/stt/run.mjs",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset --linked",
    "test:rls": "supabase test db --linked",
    "db:types": "supabase gen types typescript --linked --schema public > lib/supabase/types.ts",
    "smoke:auth": "tsx scripts/smoke-auth.ts",
    "smoke:voice": "tsx scripts/smoke-voice.ts",
    "smoke:realtime": "tsx scripts/smoke-realtime.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  }
}
